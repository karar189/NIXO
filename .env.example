# NIXO — every environment variable, grouped by service.
#
# Copy to `.env` at the repo root (git-ignored). `pnpm dev` (scripts/dev.sh)
# exports this file into web, agents and backend. Each service also works on
# its own: agents/ reads ../.env, and web/ still reads web/.env if present.
# Never commit real keys.

# ---------------------------------------------------------------- web (NIXO)
# NIXO contracts (wallet network selects which pair is used).
NEXT_PUBLIC_NIXO_CONTRACT=nixo.testnet
NEXT_PUBLIC_NIXO_CONTRACT_TESTNET=nixo.testnet
NEXT_PUBLIC_NIXO_CONTRACT_MAINNET=nixo.nixowallet.near
NEXT_PUBLIC_NIXO_VAULT_CONTRACT=nixo-vault.testnet
NEXT_PUBLIC_NIXO_VAULT_CONTRACT_TESTNET=nixo-vault.testnet
NEXT_PUBLIC_NIXO_VAULT_CONTRACT_MAINNET=vault.nixowallet.near
NIXO_CONTRACT=nixo.testnet
NIXO_VAULT_CONTRACT=nixo-vault.testnet
# Copy-trading keys contract (copykeys/, scripts/deploy-copykeys-testnet.sh).
# Unset: only labelled demo traders show and Subscribe is disabled.
NIXO_KEYS_CONTRACT=
# Feed keys rotate per epoch; subscribers get keys for epochs in their window.
# Use something short (e.g. 120) for a live demo with 5-minute periods.
NIXO_COPY_EPOCH_SECS=3600
# Seals feed keys on disk (agents/.nixo_copy) so restarts keep feeds readable.
NIXO_COPY_MASTER_KEY=
# Seed demo traders with simulated history (1 = on).
NIXO_COPY_DEMO=1
# NEAR RPC used by the NIXO pages (/, /verify).
NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com
# Block explorer for tx and account links on the NIXO pages.
NEXT_PUBLIC_EXPLORER=https://testnet.nearblocks.io
# Public repo URL shown in the "Verified" panel (re-run instructions).
NEXT_PUBLIC_REPO_URL=https://github.com/<your-org>/nixo
# Optional: link to a public Kani CI run shown in the "Verified" panel.
NEXT_PUBLIC_KANI_RUN_URL=
# Optional: OutLayer app page for the checker, shown in the "Verified" panel.
NEXT_PUBLIC_OUTLAYER_APP=

# Demo signer (server only). Testnet keys for the two pre-seeded accounts that
# the "Prove my funds are clean" button signs request_nixo with.
DEMO_ALICE_ACCOUNT=nixo-alice.testnet
DEMO_ALICE_KEY=ed25519:...
DEMO_MALLORY_ACCOUNT=nixo-mallory.testnet
DEMO_MALLORY_KEY=ed25519:...
# NEAR attached to request_nixo; forwarded to OutLayer to pay for the TEE run.
NIXO_REQUEST_DEPOSIT=0.05
# NearBlocks API v3 key for live history inside the checker enclave (OutLayer
# secret). Without it, free-tier rate limits often yield history_unavailable.
# Also used by `pnpm fetch-history` / `/verify` preview outside the TEE.
NEARBLOCKS_API_KEY=
# Local checker only: set to 1 to use compiled Alice/Mallory fixtures instead of live fetch.
# OutLayer must NOT set this — live fetch is the default in the enclave.
NIXO_OFFLINE=

# NEAR AI Cloud (server only). Used by the certificate explainer today and by
# the agents' strategy planner after the NEAR AI switch. Optional: the demo
# works without it.
# Privacy track: create a key at https://cloud.near.ai — required for /private-ai and /api/explain.
NEARAI_API_KEY=
# OpenAI-compatible base URL for NEAR AI Cloud.
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
# Prefer a TEE / nearai-owned model from GET https://cloud-api.near.ai/v1/models.
NEARAI_MODEL=deepseek-ai/DeepSeek-V3.1

# ------------------------------------------------------- web (/trade, NearArc)
# FastAPI agents service. Server-side only: /dashboard/trade, /dashboard/agents
# and Settings → AI model providers (/dashboard/settings) call the web server's
# /api/agents/* proxy, which forwards here. Required for those pages.
AGENTS_API_URL=http://localhost:8000
# NestJS waitlist service the /trade/about waitlist form posts to.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Default network for the /trade wallet: testnet or mainnet (switchable in Settings).
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Optional: override the FastNEAR RPC the /trade pages use for the default network.
NEXT_PUBLIC_NEAR_RPC_URL=

# ------------------------------------------------------------------ agents
# Port for the FastAPI agents (was PORT in NearArc; renamed to avoid the
# clash with the backend). scripts/dev.sh passes it to uvicorn.
AGENTS_PORT=8000
# Browser origins allowed to call the agents (JSON list).
CORS_ORIGINS=["http://localhost:3000","http://localhost:4000"]
# LLM providers for the strategy planner, position supervisor and the NIXO
# two-agent run. Each provider is enabled when its key is set; with none,
# the rule-based planner/agent is used. "auto" tries them in LLM_PROVIDER_ORDER
# and falls through on any failure; a provider that fails on auth or credits is
# skipped for 10 minutes. NEAR AI (NEARAI_* above) is the fifth provider.
LLM_PROVIDER_ORDER=anthropic,openai,deepseek,nvidia,nearai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# NVIDIA NIM (build.nvidia.com), OpenAI-compatible. Not every catalog model is
# enabled for every key: use Settings → AI model providers → Test to check.
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=mistralai/mistral-large-4-1t-a52b
# 1Click partner JWT. Optional for public quotes (may add a fee).
# Required for Confidential Intents (confidentiality=basic/advanced) live swaps.
ONECLICK_JWT=

# Live AI agent: REAL spot swaps on NEAR mainnet through Intents (agents/app/live/).
# Off unless NIXO_LIVE_ENABLED=1. Use a dedicated account funded with only what you
# can afford to lose: the service holds its key. Swaps always pay out and refund to it.
NIXO_LIVE_ENABLED=0
NIXO_AGENT_ACCOUNT=
# Full-access key of NIXO_AGENT_ACCOUNT (ed25519:...). Secret: never commit it.
NIXO_AGENT_PRIVATE_KEY=
# The only wallet that may start the live agent (it signs a NEP-413 message).
NIXO_AGENT_OWNER=
NIXO_LIVE_RPC=https://free.rpc.fastnear.com
NIXO_LIVE_MARKETS=NEAR,BTC,ETH
NIXO_LIVE_MAX_TRADE_USDC=25
NIXO_LIVE_MIN_TRADE_USDC=1
NIXO_LIVE_DAILY_BUDGET_USDC=100
NIXO_LIVE_MAX_SLIPPAGE_BPS=100
NIXO_LIVE_MAX_DEVIATION_BPS=150
NIXO_LIVE_SWAP_TIMEOUT=300

# ----------------------------------------------------------------- backend
# Port for the NestJS waitlist (was PORT in NearArc; renamed, see AGENTS_PORT).
BACKEND_PORT=4000
# Browser origin allowed to call the backend (CORS).
FRONTEND_ORIGIN=http://localhost:3000
# Unused: listed in NearArc's backend/.env.example but no code reads it.
AGENTS_URL=http://localhost:8000
